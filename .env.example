# RAG Chatbot — configuration template.
#
# This file is the configuration contract. `core.config.settings` validates every
# key below at startup and fails fast with a clear message if one is missing or
# malformed. Copy to `.env` and edit; `.env` is gitignored and must never be committed.
#
# Anything secret belongs in the managed secret store (see core/config/secrets.py),
# never in this file. Values below marked "placeholder" must be replaced in any
# deployment where ENVIRONMENT != "local".

# ------------------------------------------------------------------ runtime

# local | ci | staging | prod
ENVIRONMENT=local

# Reject use of the deterministic fake model adapters outside local/CI.
# This is the guard that stops a fake adapter reaching production.
ALLOW_FAKE_MODEL_ADAPTERS=true

LOG_LEVEL=INFO
LOG_FORMAT=json

# ------------------------------------------------------------------ API

API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:3000

# ------------------------------------------------------------------ identity (FR-29)

# AUTH_MODE=stub accepts a fixed development principal and MUST NOT be used
# outside local and CI. AUTH_MODE=jwt verifies a bearer token from the IdP.
AUTH_MODE=stub

AUTH_JWT_ISSUER=placeholder
AUTH_JWT_AUDIENCE=rag-chatbot
AUTH_JWT_JWKS_URL=placeholder
AUTH_JWT_ALGORITHMS=RS256

# Groups granted operator access to /api/v1/admin (comma separated).
AUTH_OPERATOR_GROUPS=rag-operators
AUTH_ADMIN_GROUPS=rag-admins

# ------------------------------------------------------------------ database

# The database is optional at startup in Phase 1: /healthz is always served and
# /readyz reports 503 when the database is unreachable. Phase 3 makes it required.
DATABASE_URL=postgresql://rag:rag@localhost:5432/rag
DATABASE_POOL_MIN_SIZE=1
DATABASE_POOL_MAX_SIZE=10
DATABASE_CONNECT_TIMEOUT_SECONDS=5
DATABASE_REQUIRED=false

# ------------------------------------------------------------------ object store (phase 2)

OBJECT_STORE_ENDPOINT=http://localhost:9000
OBJECT_STORE_BUCKET=rag-corpus
OBJECT_STORE_ACCESS_KEY=placeholder
OBJECT_STORE_SECRET_KEY=placeholder

# ------------------------------------------------------------------ queue (phase 2)

QUEUE_URL=amqp://localhost:5672
QUEUE_NAME=rag-jobs

# ------------------------------------------------------------------ models (NFR-18)

# Adapter names resolved by llm.adapters.registry. `fake` is the only adapter
# implemented in phase 1; `hosted` arrives in phase 3 (implementation.md 5.3).
# An unregistered name is a startup error -- there is no silent fallback.
CHAT_MODEL=fake
EMBEDDING_MODEL=fake
RERANKER_MODEL=fake

# Any change to this string changes content_hash and forces re-embedding
# (implementation.md phase 2). Decide it before phase 2, not during it.
EMBEDDING_MODEL_VERSION=unassigned
EMBEDDING_DIMENSIONS=1024
EMBEDDING_BATCH_SIZE=64

HOSTED_PROVIDER_BASE_URL=placeholder
HOSTED_PROVIDER_API_KEY=placeholder
# FR-43: the provider must be configured not to retain or train on our content.
HOSTED_PROVIDER_NO_TRAINING=true

# Fake adapter behaviour, used by tests and by `make eval` with no provider account.
FAKE_EMBEDDING_DIMENSIONS=1024
FAKE_CHAT_LATENCY_MS=0

# ------------------------------------------------------------------ cost tracking (NFR-19)

COST_BUDGET_PER_ANSWER_USD=0.02
COST_ALERT_PER_ANSWER_USD=0.02

# ------------------------------------------------------------------ eval

EVALS_DIR=evals
EVALS_BASELINE_DIR=evals/baselines
EVAL_JUDGE_ENABLED=false
# Groq (Phase 2)
GROQ_API_KEY=placeholder
GROQ_MODEL=qwen/qwen3.8-27b
